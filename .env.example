NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# Model used for text chat (widget chat + WhatsApp fallback). Defaults to
# gpt-4o-mini if unset.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Overrides OPENAI_CHAT_MODEL specifically for WhatsApp replies, if you want
# a different model there. Optional — falls back to OPENAI_CHAT_MODEL.
OPENAI_WHATSAPP_MODEL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPTIONAL: Business ID for the live demo widget on the landing page
# Leave empty to hide the widget entirely. Fill in when you want to enable it.
NEXT_PUBLIC_DEMO_BUSINESS_ID=

OPENAI_REALTIME_MODEL=gpt-realtime

NEXT_PUBLIC_ENABLE_VOICE=true

# Resend — get your key at https://resend.com/api-keys
RESEND_API_KEY=
# Resend's shared sender — works without domain verification for local testing
RESEND_FROM_EMAIL=onboarding@resend.dev
# Redirect ALL outgoing emails to your inbox during local dev
RESEND_DEV_OVERRIDE_TO=

# ── WhatsApp (optional) ─────────────────────────────────────────────────────
# Only needed if a business connects WhatsApp from Dashboard -> WhatsApp.
# Evolution API is a self-hosted WhatsApp gateway (https://github.com/EvolutionAPI/evolution-api) —
# point these at your own instance.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ── File uploads (optional) ─────────────────────────────────────────────────
# Supabase Storage bucket used for website image uploads. Defaults to
# "website-assets" if unset — the bucket must already exist in your project.
SUPABASE_STORAGE_BUCKET=website-assets

