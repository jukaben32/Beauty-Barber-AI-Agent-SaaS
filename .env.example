NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPTIONAL: Business ID for the live demo widget on the landing page
# Leave empty to hide the widget entirely. Fill in when you want to enable it.
NEXT_PUBLIC_DEMO_BUSINESS_ID=

OPENAI_REALTIME_MODEL=gpt-realtime

NEXT_PUBLIC_ENABLE_VOICE=true

# Resend — get your key at https://resend.com/api-keys
RESEND_API_KEY=
# Resend's shared sender — works without domain verification for local testing
RESEND_FROM_EMAIL=onboarding@resend.dev
# Redirect ALL outgoing emails to your inbox during local dev
RESEND_DEV_OVERRIDE_TO=

# ── Website Builder ────────────────────────────────────────────────────────────
# Wallet that receives USDC subscription payments
NEXT_PUBLIC_WEBSITE_BUILDER_WALLET=
# Monthly price in USDC (change here to update price everywhere)
NEXT_PUBLIC_WEBSITE_BUILDER_PRICE_USDC=1
# USDC contract on Polygon mainnet
NEXT_PUBLIC_USDC_CONTRACT_POLYGON=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
# USDC contract on Polygon Amoy testnet (only needed if you test payments there)
NEXT_PUBLIC_USDC_CONTRACT_POLYGON_AMOY=
# Polygon chain ID (137 = mainnet, 80002 = amoy testnet)
NEXT_PUBLIC_POLYGON_CHAIN_ID=137

# OPTIONAL: RPC provider used server-side to verify on-chain USDC payments
# (see src/lib/onchain.ts). Without these, verification falls back to viem's
# built-in public Polygon RPC, which is rate-limited and NOT reliable enough
# for production — get a free endpoint from Alchemy, Infura, or QuickNode.
POLYGON_RPC_URL=
POLYGON_AMOY_RPC_URL=

# REQUIRED for the Payments settings tab (Dashboard -> Settings -> Payments):
# encrypts each business's own Stripe secret key at rest (see
# src/lib/cryptoSecrets.ts). Set this to a long random string before any
# business connects Stripe — changing it later makes existing saved keys
# undecryptable. Generate one with: openssl rand -base64 32
STRIPE_KEY_ENCRYPTION_SECRET=
